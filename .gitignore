# Runtime and local data
data/*
uploads/*
outputs/*
.tools/*
.cache/*
.config/*
.tmp/*

!.gitkeep
!data/.gitkeep
!uploads/.gitkeep
!outputs/.gitkeep
!.tools/.gitkeep
!.cache/.gitkeep
!.config/.gitkeep
!.tmp/.gitkeep

# Secrets and local config
.env
.env.*
*.local.json
*.secret.*
*secrets*
*credentials*


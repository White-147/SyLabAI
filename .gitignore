# Runtime and local data
data/*
uploads/*
outputs/*
.tools/*
.cache/*
.config/*
.tmp/*

!.gitkeep
!data/.gitkeep
!uploads/.gitkeep
!outputs/.gitkeep
!.tools/.gitkeep
!.cache/.gitkeep
!.config/.gitkeep
!.tmp/.gitkeep

# Secrets and local config
.env
.env.*
*.local.json
*.secret.*
*secrets*
*credentials*

# Logs and databases
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Keep the planned SQLite infrastructure project directory tracked.
!backend/dotnet/control-plane/src/SyLabAI.Infrastructure.Sqlite/
!backend/dotnet/control-plane/src/SyLabAI.Infrastructure.Sqlite/.gitkeep

# .NET
bin/
obj/
TestResults/

# Node
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc
